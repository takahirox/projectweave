{
  "version": 1,
  "max_steps": 100,
  "nodes": {
    "review": {
      "kind": "agent",
      "instruction": "Review the task and return data.approved as a boolean.",
      "executor": {
        "type": "command",
        "argv": [
          "/path/to/review-wrapper"
        ]
      },
      "inputs": {
        "task": "/task",
        "context": "/last"
      }
    },
    "fix": {
      "kind": "agent",
      "instruction": "Fix the issues identified by the review.",
      "executor": {
        "type": "command",
        "argv": [
          "/path/to/fix-wrapper"
        ]
      },
      "inputs": {
        "task": "/task",
        "context": "/last"
      }
    }
  },
  "flow": [
    {
      "loop": {
        "flow": [
          "review",
          {
            "if": {
              "path": "/results/review/data/approved",
              "equals": false,
              "then": [
                "fix"
              ],
              "else": []
            }
          }
        ],
        "while": {
          "path": "/results/review/data/approved",
          "equals": false
        }
      }
    }
  ]
}
