{
  "version": 1,
  "max_steps": 20,
  "nodes": {
    "load": {
      "kind": "action",
      "action": "load"
    },
    "select": {
      "kind": "action",
      "action": "select",
      "inputs": {
        "items": "/results/load/data/items"
      }
    },
    "inspect": {
      "kind": "action",
      "action": "resources",
      "config": {
        "requires": {
          "primary": 1
        }
      }
    },
    "primary": {
      "kind": "agent",
      "instruction": "Implement the selected task. Return a structured task outcome and references.",
      "executor": {
        "type": "command",
        "argv": [
          "YOUR_EXECUTOR_WRAPPER"
        ],
        "timeout": 3600
      },
      "requires": {
        "primary": 1
      },
      "inputs": {
        "task": "/results/select/data/task"
      }
    },
    "gitweave": {
      "kind": "action",
      "action": "execute",
      "executor": {
        "type": "gitweave",
        "graph": "/path/to/gitweave-graph.json",
        "timeout": 3600
      },
      "requires": {
        "gitweave": 1
      },
      "inputs": {
        "task": "/results/select/data/task"
      }
    },
    "update": {
      "kind": "action",
      "action": "writeback",
      "inputs": {
        "task": "/results/select/data/task",
        "result": "/last"
      }
    },
    "empty": {
      "kind": "action",
      "action": "result",
      "config": {
        "message": "No eligible work",
        "data": {
          "status": "no_work"
        },
        "references": [],
        "usage": {}
      }
    }
  },
  "flow": [
    "load",
    "select",
    {
      "if": {
        "path": "/results/select/data/task",
        "equals": null,
        "then": [
          "empty"
        ],
        "else": [
          "inspect",
          {
            "if": {
              "path": "/results/inspect/data/available",
              "equals": true,
              "then": [
                "primary"
              ],
              "else": [
                "gitweave"
              ]
            }
          },
          "update"
        ]
      }
    }
  ]
}
