{
  "version": 1,
  "nodes": {
    "load": {
      "kind": "action",
      "action": "load"
    },
    "select": {
      "kind": "action",
      "action": "select",
      "inputs": {
        "items": "/results/load/data/items"
      }
    },
    "no_work": {
      "kind": "action",
      "action": "result",
      "config": {
        "message": "No eligible work",
        "data": {
          "status": "no_work"
        },
        "references": [],
        "usage": {}
      }
    },
    "subscription": {
      "kind": "action",
      "action": "resources",
      "config": {
        "subscriptions": [
          "subscription"
        ]
      }
    },
    "execute": {
      "kind": "action",
      "action": "execute",
      "executor": {
        "type": "gitweave",
        "graph": "gitweave.json"
      },
      "inputs": {
        "task": "/results/select/data/task"
      }
    },
    "writeback": {
      "kind": "action",
      "action": "writeback",
      "inputs": {
        "task": "/results/select/data/task",
        "result": "/results/execute"
      }
    }
  },
  "flow": [
    "load",
    "select",
    {
      "if": {
        "path": "/results/select/data/task",
        "equals": null,
        "then": [
          "no_work"
        ],
        "else": [
          "subscription",
          {
            "if": {
              "path": "/results/subscription/data/available",
              "equals": true,
              "then": [
                "execute",
                "writeback"
              ],
              "else": []
            }
          }
        ]
      }
    }
  ]
}
